# Local development — copy to .env (never commit real secrets)
# Admin connection: used by provisioning to CREATE DATABASE / ROLE for each tenant
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Control Plane DB (tenants, identities, memberships, job queue)
CONTROL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleet_control
# Host/port tenant databases are reached at (tenant DB name + role are generated per tenant)
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
# Secrets are NOT set here. Generate them with:  node apps/api/dist/cli/gen-env.js >> .env
#   MASTER_KEY           32-byte base64 key that encrypts per-tenant DB passwords in the control plane
#   JWT_PRIVATE_KEY_B64  Ed25519 private key (PKCS8 PEM, base64) that signs access tokens
API_PORT=4000
# Browser origins allowed to call the API directly (comma-separated). The web dashboard
# goes through the Next.js /api proxy; the Expo web build (port 8081) calls the API directly.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Document files, encrypted per tenant before storage. Local disk by default;
# for object storage set STORAGE_DRIVER=s3 and S3_ENDPOINT, S3_BUCKET, S3_REGION,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY (keep the keys out of the repo).
STORAGE_DIR=.data/files
