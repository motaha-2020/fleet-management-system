  },
  "dependencies": {
    "@fleet/config": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "@fleet/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
