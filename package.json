{
  "name": "fleet-management-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "db:migrate": "pnpm --filter @fleet/db migrate",
    "db:seed": "pnpm --filter @fleet/api seed"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "~5.9.3",
    "@types/node": "^22.10.0"
  }
}
