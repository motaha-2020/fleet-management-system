{
  "expo": {
    "name": "Fleet Driver",
    "slug": "fleet-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.fleetdriver",
      "supportsTablet": false
    },
    "android": {
      "package": "com.example.fleetdriver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0F5FA8"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": {
        "projectId": "3c3c4e87-3116-4ebc-9574-e0cdbd516ab3"
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0F5FA8"
        }
      ]
    ],
    "owner": "motaha2026",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/3c3c4e87-3116-4ebc-9574-e0cdbd516ab3",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png"
  }
}
