{
  "expo": {
    "name": "Fleet Driver",
    "slug": "fleet-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.fleetdriver",
      "supportsTablet": false
    },
    "android": {
      "package": "com.example.fleetdriver"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:4000",
      "eas": {
        "projectId": "3c3c4e87-3116-4ebc-9574-e0cdbd516ab3"
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store"
    ],
    "owner": "motaha2026"
  }
}
